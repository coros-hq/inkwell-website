---
import { Image } from "astro:assets";
import MobileMenu from "./MobileMenu.astro";
import { navLinks } from "../lib/nav";
import logo from "../assets/logo.svg";
import heroBg from "../assets/hero/hero-bg.avif";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import appMockup from "../assets/hero/app-mockup.png";
---

<section class="relative isolate z-10 flex min-h-screen min-h-svh flex-col overflow-x-clip text-white">
  <div class="absolute inset-0 -z-20 overflow-clip" aria-hidden="true">
    <div
      class="absolute inset-x-0 -top-[10%] -bottom-[10%] bg-cover bg-center will-change-transform"
      style={`background-image: url(${heroBg.src})`}
      data-parallax="-12"
    >
      <!-- darkened accent tint keeps the white headline readable on every theme -->
      <div class="absolute inset-0 bg-[color-mix(in_oklab,hsl(var(--accent))_25%,black)] opacity-60"></div>
    </div>
  </div>

  <div
    data-nav-bar
    class="fixed inset-x-0 top-0 z-40 pb-4 pt-6 transition-[background-color,backdrop-filter,padding] duration-300 data-[scrolled]:bg-white/70 data-[scrolled]:text-neutral-900 data-[scrolled]:py-3 data-[scrolled]:shadow-sm data-[scrolled]:backdrop-blur-md"
  >
  <header
    data-hero="nav"
    class="relative z-20 mx-auto flex w-full max-w-content xl:max-w-[88rem] items-center justify-between px-[clamp(1rem,4vw,2rem)]"
  >
    <a
      class="flex items-center gap-3 text-inherit no-underline"
      href="/"
      aria-label="Inkwell home"
    >
      <Image class="" src={logo} alt="inkwell-logo" width={26} height={26} />
      <span class="text-xl font-normal">Inkwell</span>
    </a>
    <div class="flex items-center gap-3">
      <nav class="mr-4 hidden md:block" aria-label="Main">
        <ul class="flex items-center gap-8">
          {navLinks.map((l) => (
            <li>
              <a
                class="font-light text-inherit no-underline opacity-90 transition hover:opacity-100"
                href={l.href}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a
        class="grid size-10 shrink-0 place-items-center rounded-full text-inherit no-underline transition hover:bg-current/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
        href="https://github.com/coros-hq/inkwell"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Inkwell on GitHub"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.38 7.86 10.9.58.1.79-.25.79-.56 0-.27-.01-1.17-.02-2.13-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.74.4-1.26.72-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.58.24 2.75.12 3.04.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.42.36.78 1.07.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
        </svg>
      </a>
      <a
        class="grid size-10 shrink-0 place-items-center rounded-full text-inherit no-underline transition hover:bg-current/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current"
        href="https://discord.gg/YkdyfzNBX"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Join the Inkwell Discord server"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.32 4.37a19.8 19.8 0 0 0-4.9-1.52.07.07 0 0 0-.08.04c-.21.38-.45.86-.61 1.25a18.3 18.3 0 0 0-5.47 0 12.6 12.6 0 0 0-.63-1.25.08.08 0 0 0-.08-.04c-1.7.3-3.36.8-4.9 1.52a.07.07 0 0 0-.03.03C.63 8.3-.38 12.1.12 15.84c0 .02.01.04.03.05a20 20 0 0 0 6.02 3.04.08.08 0 0 0 .08-.03c.46-.64.88-1.3 1.24-2a.08.08 0 0 0-.04-.1 13 13 0 0 1-1.87-.9.08.08 0 0 1 0-.13c.13-.09.25-.19.37-.28a.07.07 0 0 1 .08-.01c3.93 1.8 8.18 1.8 12.07 0a.07.07 0 0 1 .08.01c.12.1.24.19.37.28a.08.08 0 0 1-.01.13c-.6.35-1.22.65-1.87.9a.08.08 0 0 0-.04.1c.37.7.79 1.36 1.24 2a.08.08 0 0 0 .08.03 20 20 0 0 0 6.03-3.04.08.08 0 0 0 .03-.05c.6-4.33-.5-8.09-2.12-11.44a.06.06 0 0 0-.03-.03ZM8.02 13.5c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.95 2.42-2.16 2.42Z" />
        </svg>
      </a>
      <ThemeSwitcher />
      <MobileMenu />
    </div>
  </header>
  </div>

  <div class="mx-auto flex w-full max-w-content flex-1 pt-20 flex-col lg:grid lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] xl:max-w-[88rem] lg:items-center lg:gap-12 lg:px-[clamp(1rem,4vw,2rem)] lg:pt-16 lg:pb-28">
    <div class="mx-auto mt-[clamp(2.5rem,8vw,5rem)] max-w-2xl px-[clamp(1rem,4vw,2rem)] text-center lg:mx-0 lg:mt-0 lg:max-w-none lg:px-0 lg:text-left">
      <h1 class="text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.1] lg:text-5xl xl:text-6xl font-semibold tracking-tight">
        <span class="block overflow-hidden pb-[0.1em]">
          <span class="block" data-hero="line">
            Write freely.
          </span>
        </span>
        <span class="block overflow-hidden pb-[0.1em]">
          <span class="block" data-hero="line">
            Own everything.
          </span>
        </span>
      </h1>
      <p
        data-hero="lead"
        class="mt-10 text-[clamp(1.125rem,3vw,1.5rem)] leading-normal font-light lg:mt-8 lg:text-xl"
      >
        inkwell is a focused, beautiful markdown note-taking app for your
        desktop. Your notes are plain .md files in a folder you control: no
        lock-in, no noise, no account required.
      </p>
    </div>

    <div
      data-hero="mockup"
      class="relative mx-auto w-full max-lg:flex-1 mt-[clamp(2rem,6vw,3.5rem)] max-w-160 px-[clamp(1rem,4vw,2rem)] pb-[clamp(2.5rem,8vw,4rem)] lg:mt-0 lg:max-w-none lg:px-0 lg:pb-0 lg:before:hidden before:absolute before:inset-x-1/2 before:bottom-0 before:-z-10 before:w-screen before:-translate-x-1/2 before:top-[calc(50%-5.5rem-clamp(2rem,6vw,4rem)/2)] before:bg-[linear-gradient(to_bottom,transparent,hsl(var(--surface))_4rem,hsl(var(--background))_4rem)] before:content-['']"
    >
      <Image
        class="block aspect-[2000/1179] h-auto w-full rounded-lg shadow-[0_0.75rem_1.5rem_rgb(0_0_0/0.15)]"
        src={appMockup}
        width={1800}
        alt="Inkwell showing a note in the editor with folders, tags and quick links in the sidebar"
        loading="eager"
        decoding="sync"
      />
    </div>
  </div>
</section>

<script>
  const bar = document.querySelector<HTMLElement>("[data-nav-bar]");
  const update = () => bar?.toggleAttribute("data-scrolled", window.scrollY > 24);
  update();
  window.addEventListener("scroll", update, { passive: true });
</script>
