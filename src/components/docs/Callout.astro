---
import { Lightbulb, Info, TriangleAlert } from '@lucide/astro';

interface Props {
	type?: 'tip' | 'note' | 'warning';
	title?: string;
}

const { type = 'note', title } = Astro.props;
const meta = {
	tip: { label: 'Tip', Icon: Lightbulb, box: 'border-accent bg-tag-bg', icon: 'text-tag-text' },
	note: { label: 'Note', Icon: Info, box: 'border-border-strong bg-surface', icon: 'text-muted-foreground' },
	warning: { label: 'Warning', Icon: TriangleAlert, box: 'border-destructive bg-surface', icon: 'text-destructive' },
}[type];
const { Icon } = meta;
---

<aside class={`not-prose my-6 flex gap-3 rounded-xl border-l-4 p-4 ${meta.box}`} data-callout={type}>
	<Icon class={`mt-0.5 size-5 shrink-0 ${meta.icon}`} aria-hidden="true" />
	<div class="min-w-0 text-base leading-relaxed text-foreground [&>:first-child]:mt-0 [&>:last-child]:mb-0">
		<p class="mb-1 font-semibold">{title ?? meta.label}</p>
		<slot />
	</div>
</aside>
