---
import { themes } from '../../lib/themes';
---

<ul class="not-prose my-6 grid gap-3 sm:grid-cols-2" data-theme-swatches>
	{
		themes.map((t) => (
			<li class="flex items-center gap-4 rounded-xl border border-border bg-card p-3">
				<span
					class="relative grid h-14 w-20 shrink-0 grid-cols-[1fr_2.2fr] overflow-hidden rounded-lg border border-border-strong"
					style={`background:${t.bg}`}
					aria-hidden="true"
				>
					<span style={`background:${t.sidebar}`} class="border-r" />
					<span class="flex flex-col justify-center gap-1.5 px-2">
						<span class="h-1.5 w-8 rounded-full" style={`background:${t.text}`} />
						<span class="h-1.5 w-5 rounded-full" style={`background:${t.accent}`} />
					</span>
				</span>
				<span class="min-w-0">
					<span class="block font-semibold text-foreground">
						{t.label} <span class="text-sm font-normal text-muted-foreground">· {t.mode}</span>
					</span>
					<span class="block text-sm text-muted-foreground">{t.description}</span>
				</span>
			</li>
		))
	}
</ul>
