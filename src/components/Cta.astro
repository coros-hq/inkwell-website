<section class="px-[clamp(1rem,4vw,2rem)] pb-12 md:pb-20">
	<div data-reveal="scale" class="mx-auto max-w-4xl rounded-[2rem] bg-accent px-6 py-14 text-center text-accent-foreground md:px-12 md:py-20">
		<h2 class="text-3xl leading-tight font-semibold tracking-tight md:text-5xl">
			Your notes deserve<br />a home you own.
		</h2>
		<p class="mx-auto mt-4 max-w-md text-lg leading-snug font-light md:text-xl">
			Download inkwell, pick a folder, and start writing in plain markdown.
		</p>
		<a
			href="#download"
			class="mt-8 inline-flex items-center gap-2 rounded-full bg-background px-8 py-3.5 text-lg font-semibold text-foreground no-underline shadow-[0_6px_20px_rgb(0_0_0/0.2)] transition hover:-translate-y-0.5 hover:shadow-[0_10px_28px_rgb(0_0_0/0.25)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-foreground"
		>
			Download inkwell
			<span aria-hidden="true">→</span>
		</a>
	</div>
</section>
