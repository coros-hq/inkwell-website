---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getDocsNav, docUrl } from '../../lib/docs';

const nav = await getDocsNav();
---

<DocsLayout
	title="Documentation"
	description="Learn how to write, organise, share and customise your notes in inkwell, the local-first markdown notes app for macOS, Windows and Linux."
>
	<p class="text-lg font-light text-muted-foreground">
		inkwell stores your notes as plain markdown files in a folder you choose. These guides walk through every feature, step by step.
		New here? Start with <a href="/docs/getting-started/">Getting started</a>, or press <kbd class="kbd"><span data-os="mac">⌘K</span><span data-os="other">Ctrl+K</span></kbd> to search.
	</p>
	<div class="not-prose mt-12! space-y-10">
		{nav.map((g) => (
			<section aria-labelledby={`group-${g.group}`}>
				<h2 id={`group-${g.group}`} class="border-b border-border pb-2 text-sm font-semibold tracking-wide text-muted-foreground uppercase">{g.group}</h2>
				<ul class="list-none divide-y divide-border p-0">
					{g.items.map((d) => (
						<li>
							<a href={docUrl(d.id)} class="group grid gap-1 rounded-lg px-2 py-4 text-foreground no-underline transition hover:bg-muted md:grid-cols-[14rem_1fr_auto] md:items-baseline md:gap-6">
								<span class="font-medium">{d.data.title}</span>
								<span class="text-base font-light text-muted-foreground">{d.data.description}</span>
								<span class="hidden text-tertiary transition group-hover:translate-x-1 group-hover:text-foreground md:inline" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</DocsLayout>
